;; shadow-cljs configuration
{:source-paths
 ["src/main" "src/test" "src/dev"]

 ;; datascript: test-only — backs the fake Logseq host (src/test/.../fake_logseq.cljs).
 ;; Never required from src/main, so it is not compiled into main.js.
 :dependencies
 [[datascript "1.4.2"]]

 :dev-http {8080 "./"}

 :nrepl        {:port 8702}

 :builds
 {:app
  {:target :browser
   :output-dir "./"
   :modules {:main {:init-fn logseq-ai-hub.core/init}}
   ;; externs/app.txt (auto-loaded) reserves Logseq entity props Closure would otherwise rename (.uuid)
   }

  :node-test {:target :node-test
              :output-to "out/test/node-tests.js"
              :ns-regexp ".*-test$"}}

 }
