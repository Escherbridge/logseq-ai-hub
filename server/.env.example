# =============================================================================
# Logseq AI Hub - Server Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the HTTP server listens on
PORT=3000


# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# API token required by the Logseq plugin to authenticate with this server
# REQUIRED - generate a strong random string (e.g. openssl rand -hex 32)
PLUGIN_API_TOKEN=your-plugin-api-token-here


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Path to the SQLite database file
DATABASE_PATH=./data/hub.sqlite


# -----------------------------------------------------------------------------
# LLM (Default provider: OpenRouter - https://openrouter.ai)
# -----------------------------------------------------------------------------

# API key for your LLM provider (OpenRouter or OpenAI-compatible)
LLM_API_KEY=your-llm-api-key-here

# Alternatively, set OPENROUTER_API_KEY (takes precedence if both are set)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Base URL for the LLM API endpoint (OpenRouter default shown)
LLM_ENDPOINT=https://openrouter.ai/api/v1

# Model identifier to use for agent requests
AGENT_MODEL=anthropic/claude-sonnet-4

# Timeout in milliseconds for a single LLM request
AGENT_REQUEST_TIMEOUT=30000

# Optional: HTTP Referer sent to OpenRouter (used for leaderboard ranking)
# LLM_HTTP_REFERER=https://your-app-domain.com

# Optional: App title sent to OpenRouter (used for leaderboard ranking)
# LLM_TITLE=Logseq AI Hub

# Optional: JSON object of extra headers merged onto every upstream LLM request,
# overriding same-named headers case-insensitively (e.g. Azure OpenAI's api-key).
# These, plus LLM_API_KEY/LLM_ENDPOINT above, also back the /api/llm/* relay the
# plugin's "hub-server" LLM transport uses for gateways that send no CORS headers.
# LLM_EXTRA_HEADERS={"api-key":"your-azure-key"}

# Optional: comma-separated tokens that unlock ONLY /api/llm/* (chat completions + models),
# never /mcp, /api/send, or the agent bridge. Hand one of these to org users who need LLM
# access — never PLUGIN_API_TOKEN, which also unlocks graph read/write/delete, secrets, and
# broadcasts MCP requests to every linked plugin. One token per user; revoke by deleting it
# from the list and restarting. Each entry must be >=16 chars (openssl rand -hex 16) and must
# not equal PLUGIN_API_TOKEN.
# LLM_RELAY_TOKENS=token-for-alice,token-for-bob

# Optional: seconds the relay waits for the upstream gateway before returning a clean 504.
# Integer from 10 to 240; default 110. Raise it for slow non-streamed reasoning-model
# generations. An invalid value is recorded (see "LLM config errors" below) and falls back
# to 110 rather than crashing the server. Bun's own idleTimeout is derived from this value
# (see services/sse.ts), so it always stays above it.
# LLM_RELAY_TIMEOUT_SECONDS=110

# A typo in any of the optional LLM_* variables above never crashes the server: it's recorded
# (never logging the raw value) and LLM features are disabled until fixed — MCP, SSE, and
# messaging stay up. Check the startup "Warning:" lines or GET /health's llmRelay.errors count.

# Optional: comma-separated allowlist of models the relay will forward to upstream. A request
# for any other model gets 400 model_not_allowed and never reaches the gateway. Empty/unset
# allows any model.
# LLM_ALLOWED_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o


# -----------------------------------------------------------------------------
# Messaging (WhatsApp / Telegram)
# -----------------------------------------------------------------------------

# WhatsApp Cloud API - verify token for webhook validation
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token-here

# WhatsApp Cloud API - access token for sending messages
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here

# WhatsApp Cloud API - phone number ID
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-here

# Telegram Bot API token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here


# -----------------------------------------------------------------------------
# Events
# -----------------------------------------------------------------------------

# Number of days to retain hub events before purging
EVENT_RETENTION_DAYS=30

# Maximum number of messages to keep per session
SESSION_MESSAGE_LIMIT=50

# Maximum number of items returned by list endpoints
LIST_LIMIT_MAX=100


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Secret used to validate incoming webhook signatures
WEBHOOK_SECRET=your-webhook-secret-here

# JSON array of allowed HTTP origins / IPs for the allowlist (default: allow all)
# Example: ["https://trusted-origin.com","https://another-origin.com"]
HTTP_ALLOWLIST=[]


# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------

# Public origin used to build outbound links (approval links sent to WhatsApp/
# Telegram, and the /mcp/config discovery snippet). Without it those links fall
# back to http://localhost:<PORT>, which is wrong once deployed.
# On Railway this is derived automatically from RAILWAY_PUBLIC_DOMAIN.
# BASE_URL=https://your-app.up.railway.app
